# Copy this file to .env and set a project that has Vertex AI enabled.
GCP_PROJECT_ID=your-gcp-project
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
TAVILY_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=200
LLM_TIMEOUT_SECONDS=300

# Run independent stage pairs sequentially to reduce simultaneous AI requests.
STAGE_SERIAL=1
STAGE_GAP_SECONDS=8
JUDGE_GAP_SECONDS=15
